# TYPO3 composer-managed project
/.Build/
/vendor/
/var/

# public/ is fully generated in Composer mode (index.php, typo3, _assets, fileadmin, …)
/public/

# TYPO3 system config (contains encryption key / credentials) — keep only site config
/config/*
!/config/sites/

# Node / frontend build
/node_modules/

# IDE / tooling
/.idea/
.claude/settings.local.json
.DS_Store
