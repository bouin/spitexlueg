# TYPO3 composer-managed project
/.Build/
/vendor/
/var/

# public/ is fully generated in Composer mode (index.php, typo3, _assets, fileadmin, …)
/public/

# TYPO3 system config (contains encryption key / credentials) — keep only site config
/config/*
!/config/sites/
# Site config is managed per environment (edited via backend / on the server);
# don't let git overwrite it on deploy.
/config/sites/lueg/config.yaml

# Node / frontend build (root and inside packages)
node_modules/

# IDE / tooling
/.idea/
.claude/settings.local.json
.DS_Store
