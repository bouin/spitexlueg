styles {
    templates {
        templateRootPath = EXT:site_package/Resources/Private/Templates/
        partialRootPath = EXT:site_package/Resources/Private/Partials/
        layoutRootPath = EXT:site_package/Resources/Private/Layouts/
    }
}

# UID of the Powermail *content element* embedded in the "Direkt bewerben"
# section. Configure the form, receiver, subject etc. on that element in the
# backend (List view); this just renders it. (tt_content uid, not the form uid.)
lueg.bewerbenElement = 13

# NOTE: the Powermail notification-mail "From" override is NOT done in TypoScript.
# The flexform-configured form drops the plugin.tx_powermail...receiver.overwrite
# subtree before it reaches the mail service, so no TypoScript/constant override
# takes effect. It is handled in PHP instead — see
# Classes/EventListener/PowermailReceiverMailFrom.php.
