styles {
    templates {
        templateRootPath = EXT:site_package/Resources/Private/Templates/
        partialRootPath = EXT:site_package/Resources/Private/Partials/
        layoutRootPath = EXT:site_package/Resources/Private/Layouts/
    }
}

# UID of the Powermail *content element* embedded in the "Direkt bewerben"
# section. Configure the form, receiver, subject etc. on that element in the
# backend (List view); this just renders it. (tt_content uid, not the form uid.)
lueg.bewerbenElement = 13

# Powermail: force the notification mail's "From" to our own domain so mail
# providers (Gmail & co.) stop flagging it as spoofed — by default the "From"
# is the applicant's own address. These override Powermail's empty defaults
# because this set (lueg/site-package) is last in the site's dependencies.
# NOTE: this only fixes the visible From. For mails to actually land (no spam
# warning) the host must allow sending from luegjobs.ch (SPF + DKIM, or SMTP
# through a real luegjobs.ch mailbox).
plugin.tx_powermail.settings.receiver.overwrite.senderEmail = noreply@luegjobs.ch
plugin.tx_powermail.settings.receiver.overwrite.senderName = Spitex Region Lueg
