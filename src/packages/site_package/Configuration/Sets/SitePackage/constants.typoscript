styles {
    templates {
        templateRootPath = EXT:site_package/Resources/Private/Templates/
        partialRootPath = EXT:site_package/Resources/Private/Partials/
        layoutRootPath = EXT:site_package/Resources/Private/Layouts/
    }
}

# UID of the Powermail application form embedded in the "Direkt bewerben" section.
# There is one application form site-wide; set this to its uid (List › Forms).
lueg.bewerbenForm = 1
