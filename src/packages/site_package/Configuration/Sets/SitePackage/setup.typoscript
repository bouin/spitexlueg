
config {
    no_cache = 0
    uniqueLinkVars = 1
    pageTitleFirst = 1
    linkVars = L
    prefixLocalAnchors = all
    renderCharset = utf-8
    metaCharset = utf-8
    doctype = html5
    removeDefaultJS = 0
    compressJs = 0
    compressCss = 0
    concatenateJs = 0
    concatenateCss = 0
    sendCacheHeaders = 1
    index_enable = 1
    spamProtectEmailAddresses = 1
    spamProtectEmailAddresses_atSubst = (at)
}

page = PAGE
page {
    typeNum = 0

    bodyTag >
    bodyTagCObject = TEXT
    bodyTagCObject.dataWrap = <body id="top" class="page-{field:uid} parent-page-{field:pid}">

    shortcutIcon = fileadmin/favicon/spitex-favicon.png

    # Responsive: without this, phones render at ~980px desktop width and shrink
    # everything (tiny text). Makes the layout use the real device width.
    meta {
        viewport = width=device-width, initial-scale=1
    }

    # Adobe Fonts (Typekit) — loaded before the site CSS so font-family can use it.
    includeCSSLibs {
        typekit = https://use.typekit.net/icw4udj.css
        typekit.external = 1
    }

    # Frontend assets, built by Vite/Tailwind from Resources/Public/Assets/Src/.
    includeCSS {
        site_package = EXT:site_package/Resources/Public/Assets/Dist/Css/app.css
    }

    includeJSFooter {
        site_package = EXT:site_package/Resources/Public/Assets/Dist/JavaScript/app.js
        site_package.type = module
    }

    10 = FLUIDTEMPLATE
    10 {
        templateName = TEXT
        templateName {
            cObject = TEXT
            cObject {
                data = pagelayout
                required = 1
                # strip the "pagets__" prefix that backend_layout adds
                split {
                    token = pagets__
                    cObjNum = 1
                    1.current = 1
                }
            }
            ifEmpty = Default
        }

        templateRootPaths {
            0 = EXT:site_package/Resources/Private/Templates/
            10 = {$styles.templates.templateRootPath}
        }
        partialRootPaths {
            0 = EXT:site_package/Resources/Private/Partials/
            10 = {$styles.templates.partialRootPath}
        }
        layoutRootPaths {
            0 = EXT:site_package/Resources/Private/Layouts/
            10 = {$styles.templates.layoutRootPath}
        }

        dataProcessing {
            10 = menu
            10 {
                as = mainNavigation
                levels = 2
                expandAll = 1
                includeSpacer = 1
                titleField = nav_title // title
            }

            # {site} — the Site object (not available in Fluid without this).
            5 = TYPO3\CMS\Frontend\DataProcessing\SiteProcessor
            5 {
                as = site
            }

            # {languagenavigation} — language switcher.
            15 = TYPO3\CMS\Frontend\DataProcessing\LanguageMenuProcessor
            15 {
                languages = auto
                as = languagenavigation
            }

            # {media} — "Media" field of the current page.
            20 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
            20 {
                references.fieldName = media
                as = media
            }

            # Fallback: "Media" of the site root page, so one hero image set on the
            # root page serves the whole site unless a page overrides it.
            30 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
            30 {
                table = pages
                pidInList = root
                recursive = 0
                where = uid = ###ROOTUID###
                markers {
                    ROOTUID.data = leveluid:0
                    ROOTUID.intval = 1
                }
                as = siteRoot
                dataProcessing {
                    10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
                    10 {
                        references.fieldName = media
                        as = heroFiles
                    }
                }
            }
        }
    }
}

# Fluid Styled Content is pulled in via the set dependency (typo3/fluid-styled-content).

# Content per backend-layout region (colPos).
lib.contentHeader < styles.content.get
lib.contentHeader.select.where = colPos = 1

lib.contentBody < styles.content.get
lib.contentBody.select.where = colPos = 0

lib.contentFooter < styles.content.get
lib.contentFooter.select.where = colPos = 2

# ---- News (EXT:news) — job openings -----------------------------------------
# List renders on the home one-pager, detail on the "Freie Stellen" page (uid 3),
# records stored in the "Jobs" folder (uid 8). Templates overridden to match the
# site design (reuses the .stellen* classes).
plugin.tx_news {
    view {
        templateRootPaths.100 = EXT:site_package/Resources/Private/Templates/
        partialRootPaths.100 = EXT:site_package/Resources/Private/Partials/
        layoutRootPaths.100 = EXT:site_package/Resources/Private/Layouts/
    }
    settings {
        startingpoint = 8
        detailPid = 3
        list.paginate.itemsPerPage = 50
        list.hidePagination = 1
    }
}

# ---- Powermail: dynamic "Stelle" select options from the News (Jobs) ---------
# Referenced by the select field's "create_from_typoscript" = lib.powermailStellen.
# Outputs one option per line ("Spontantbewerbung" first, then every open job).
lib.powermailStellen = COA
lib.powermailStellen {
    10 = TEXT
    10.value = Spontantbewerbung
    10.noTrimWrap = ||[\n]|

    20 = CONTENT
    20 {
        table = tx_news_domain_model_news
        select {
            pidInList = 8
            orderBy = sorting
            where = hidden = 0
        }
        renderObj = TEXT
        renderObj {
            field = title
            noTrimWrap = ||[\n]|
        }
    }
}

# ---- Powermail: render the configured plugin element in the "bewerben" block --
# We render the real Powermail content element (uid {$lueg.bewerbenElement}) so
# it brings its own flexform mail configuration — receiver address, receiver
# name, subject, sender — which a form built from bare TypoScript would lack.
# dontCheckPid: the element lives in a storage/nested pid, not the current page.
lib.powermailForm = RECORDS
lib.powermailForm {
    tables = tt_content
    source = {$lueg.bewerbenElement}
    dontCheckPid = 1
}

lib.sectionMenu = HMENU
lib.sectionMenu {
    special = directory
    special.value = 1

    1 = TMENU
    1 {
        wrap = <nav class="pill-nav" aria-label="Kampagnen-Navigation">|</nav>

        NO = 1
        NO {
            ATagParams = class="pill-nav__link"
            stdWrap.htmlSpecialChars = 1

            //freie-jobs
            doNotLinkIt = 1
            doNotLinkIt {
                if {
                    value = /freie-jobs
                    equals.field = slug
                }
            }

            stdWrap.wrap = <a class="pill-nav__link" href="/#freie-stellen">|</a>
            stdWrap.wrap {
                if {
                    value = /freie-jobs
                    equals.field = slug
                }
            }
        }
    }
}
