page = PAGE
page {
    typeNum = 0

    # Frontend assets (CSS/JS) are handled by Vite via the <vite:asset> ViewHelper
    # in Resources/Private/Layouts/Default.html — see EXT:site_package Configuration/ViteEntrypoints.json.

    10 = FLUIDTEMPLATE
    10 {
        templateName = TEXT
        templateName {
            cObject = TEXT
            cObject {
                data = pagelayout
                required = 1
                # strip the "pagets__" prefix that backend_layout adds
                split {
                    token = pagets__
                    cObjNum = 1
                    1.current = 1
                }
            }
            ifEmpty = Default
        }

        templateRootPaths {
            0 = EXT:site_package/Resources/Private/Templates/
            10 = {$styles.templates.templateRootPath}
        }
        partialRootPaths {
            0 = EXT:site_package/Resources/Private/Partials/
            10 = {$styles.templates.partialRootPath}
        }
        layoutRootPaths {
            0 = EXT:site_package/Resources/Private/Layouts/
            10 = {$styles.templates.layoutRootPath}
        }

        dataProcessing {
            10 = menu
            10 {
                as = mainNavigation
                levels = 2
                expandAll = 1
                includeSpacer = 1
                titleField = nav_title // title
            }

            # Site-wide hero media: read the "Media" field of the site root page,
            # so an editor sets the hero image once on the root page for the whole site.
            20 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
            20 {
                table = pages
                pidInList = root
                recursive = 0
                where = uid = ###ROOTUID###
                markers {
                    ROOTUID.data = leveluid:0
                    ROOTUID.intval = 1
                }
                as = siteRoot
                dataProcessing {
                    10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
                    10 {
                        references.fieldName = media
                        as = heroFiles
                    }
                }
            }
        }
    }
}

# Fluid Styled Content is pulled in via the set dependency (typo3/fluid-styled-content).

# Content per backend-layout region (colPos).
lib.contentHeader < styles.content.get
lib.contentHeader.select.where = colPos = 1

lib.contentBody < styles.content.get
lib.contentBody.select.where = colPos = 0

lib.contentFooter < styles.content.get
lib.contentFooter.select.where = colPos = 2
